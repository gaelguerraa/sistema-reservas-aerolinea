# Copia este archivo como .env y reemplaza los valores de relleno.
# El archivo .env real NO se sube al repositorio.

# "memoria" o "mysql"
PERSISTENCIA=mysql

# mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://USUARIO:PASSWORD@localhost:3306/reservas_aerolinea"

# Usuario administrador que crea el seeder
SEED_ADMIN_EMAIL=admin@ejemplo.com
SEED_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# Puerto donde escucha el servicio HTTP
PORT=3000

# Origen(es) del front que pueden llamar al servicio (CORS).
# Varios se separan con coma. Cualquier otro origen se rechaza.
CORS_ORIGIN=http://localhost:5173
