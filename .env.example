# Copiar como .env. Usar solamente una base local de desarrollo.
PERSISTENCIA=mysql
DATABASE_URL="mysql://reservas:REEMPLAZAR_CLAVE_APP@127.0.0.1:3307/reservas"
SEED_ADMIN_EMAIL=admin@ejemplo.com
SEED_ADMIN_PASSWORD=REEMPLAZAR_ADMIN
SEED_CLIENT_EMAIL=cliente@ejemplo.com
SEED_CLIENT_PASSWORD=REEMPLAZAR_CLIENTE
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:4200
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_PROPIO_DE_32_BYTES_O_MAS
JWT_TTL_SECONDS=900

# Solo para levantar compose.yml
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CLAVE_ROOT_LOCAL
MYSQL_APP_PASSWORD=REEMPLAZAR_CLAVE_APP
